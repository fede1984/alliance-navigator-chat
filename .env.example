# Create a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Gemini is used automatically when Groq reaches its free limit.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3001
# SYSTEM_PROMPT=You are a helpful assistant.

# Demo protection. Set TRUST_PROXY=true only behind a trusted reverse proxy.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
TRUST_PROXY=false
STREAM_DELAY_MS=0
STREAM_DELAY_MAX_EVENTS=80
